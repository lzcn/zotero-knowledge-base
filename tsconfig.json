{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["zotero-types"],
    "strict": true,
    "outDir": "build/dist/",
    "skipLibCheck": true
  },
  "include": ["src", "typings"],
  "exclude": ["build", "addon", "src/ui/markdown-editor"]
}
