{
  "name": "zotero-knowledge-base",
  "type": "module",
  "version": "0.7.2",
  "description": "Notes, tags and related papers for Zotero",
  "config": {
    "addonName": "Knowledge Base",
    "addonID": "knowledge-base@lzcn",
    "addonRef": "knowledge-base",
    "addonInstance": "ZoteroKnowledgeBase",
    "prefsPrefix": "extensions.zotero.knowledge-base"
  },
  "author": "Zhi Lu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzcn/zotero-knowledge-base.git"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "npm run check && node scripts/package-release.mjs",
    "test": "node --test tests/run.test.mjs tests/lifecycle.test.mjs tests/package.test.mjs && npm run test:library",
    "test:db": "node tests/database.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:pane": "node tests/item-pane.mjs",
    "test:host": "node scripts/test-zotero-quit.mjs",
    "test:workbench:host": "node scripts/test-zotero-quit.mjs --workbench",
    "test:graph-views:host": "node scripts/test-zotero-quit.mjs --graph-views",
    "test:views:host": "node scripts/test-zotero-quit.mjs --views",
    "test:settings:host": "node scripts/test-zotero-quit.mjs --settings",
    "test:metadata:host": "node scripts/test-zotero-quit.mjs --metadata",
    "test:reading-view:host": "node scripts/test-zotero-quit.mjs --reading-view",
    "test:text-tools:host": "node scripts/test-zotero-quit.mjs --text-tools",
    "test:reader-toolbar:host": "node scripts/test-zotero-quit.mjs --reader-toolbar",
    "test:context-menu:host": "node scripts/test-zotero-quit.mjs --context-menu",
    "test:trash:host": "node scripts/test-zotero-quit.mjs --trash",
    "test:appearance:host": "node scripts/test-zotero-quit.mjs --appearance",
    "test:toolbar:host": "node scripts/test-zotero-quit.mjs --toolbar",
    "test:templates:host": "node scripts/test-zotero-quit.mjs --templates",
    "test:retired-features:host": "node scripts/test-zotero-quit.mjs --retired-features",
    "test:links:host": "node scripts/test-zotero-quit.mjs --links",
    "test:relations:host": "node scripts/test-zotero-quit.mjs --relations",
    "benchmark:graph": "node scripts/benchmark-graph.mjs",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "benchmark:loading": "node scripts/benchmark-loading.mjs",
    "test:cursor": "node scripts/test-native-cursor.mjs",
    "check": "npm run lint:check && node scripts/build.mjs --check && npm test",
    "lint": "npm run lint:check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "build:force": "node scripts/build.mjs --force",
    "test:types:host": "node scripts/test-zotero-quit.mjs --note-types",
    "test:library": "node --test tests/library/*.test.js",
    "test:library:host": "node scripts/test-library-host.mjs",
    "test:tag-semantics": "node scripts/test-tag-semantics.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "dompurify": "3.4.16",
    "fastpriorityqueue": "0.8.0",
    "katex": "0.18.10",
    "marked": "18.0.14",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zotero-plugin-toolkit": "4.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@huggingface/transformers": "3.8.1",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/katex": "0.16.8",
    "@types/node": "22.13.10",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "prettier": "3.5.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1",
    "zotero-plugin-scaffold": "0.9.2",
    "zotero-types": "3.1.9"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "private": true,
  "overrides": {
    "epubjs": {
      ".": "0.3.93",
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
