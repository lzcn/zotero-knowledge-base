{
  "name": "zotero-knowledge-base",
  "type": "module",
  "version": "0.1.0",
  "description": "Connected idea cards for Zotero",
  "config": {
    "addonName": "Knowledge Base",
    "addonID": "knowledge-base@lzcn",
    "addonRef": "knowledge-base",
    "addonInstance": "ZoteroKnowledgeBase",
    "prefsPrefix": "extensions.zotero.knowledge-base"
  },
  "author": "Zhi Lu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzcn/zotero-knowledge-base.git"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "npm run typecheck && node scripts/build.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "npm run check && node scripts/package-release.mjs",
    "test": "node --test tests/run.test.mjs tests/lifecycle.test.mjs tests/package.test.mjs",
    "test:db": "node tests/database.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:pane": "node tests/item-pane.mjs",
    "check": "npm run lint:check && npm test && npm run build",
    "lint": "npm run lint:check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json"
  },
  "dependencies": {
    "d3-force": "3.0.0",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zotero-plugin-toolkit": "4.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.13.10",
    "@types/turndown": "5.0.6",
    "eslint": "9.39.5",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "prettier": "3.5.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1",
    "zotero-plugin-scaffold": "0.9.2",
    "zotero-types": "3.1.9",
    "esbuild": "0.28.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "private": true,
  "overrides": {
    "epubjs": {
      ".": "0.3.93",
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
